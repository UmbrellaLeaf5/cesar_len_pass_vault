#:kivy 2.3

<VaultScreen>:
  editor: editor
  backup_editor: backup_editor
  primary_scroll: primary_scroll
  backup_scroll: backup_scroll
  status_label: status_label
  toolbar: toolbar
  hide_button: hide_button

  BoxLayout:
    orientation: "vertical"
    padding: '4dp'
    spacing: '4dp'

    Toolbar:
      id: toolbar
      size_hint_y: None
      height: '48dp'
      download_enabled: root._state.value in ("empty", "loaded", "split")
      upload_enabled: root._state.value in ("loaded", "split")
      add_enabled: root._state.value in ("loaded", "split")

      BoxLayout:
        spacing: '4dp'
        padding: '2dp'

        CustomButton:
          text: "Download"
          disabled: not toolbar.download_enabled
          opacity: 1 if toolbar.download_enabled else 0.4
          on_release: root.download()

        CustomButton:
          text: "Upload"
          disabled: not toolbar.upload_enabled
          opacity: 1 if toolbar.upload_enabled else 0.4
          on_release: root.upload()

        CustomButton:
          text: "+ Entry"
          disabled: not toolbar.add_enabled
          opacity: 1 if toolbar.add_enabled else 0.4
          on_release: root.open_add_entry()

        CustomButton:
          id: hide_button
          text: "Show"
          width: "60dp"
          size_hint_x: None
          disabled: not toolbar.add_enabled
          opacity: 1 if toolbar.add_enabled else 0.4
          on_release: root._toggle_passwords()

        CustomButton:
          text: "*"
          font_size: '20sp'
          width: '48dp'
          size_hint_x: None
          on_release: root.open_settings()

    BoxLayout:
      orientation: "horizontal"

      ScrollView:
        id: primary_scroll
        do_scroll_x: False
        bar_width: '4dp'
        scroll_distance: '10dp'
        scroll_timeout: 150

        CustomTextInput:
          id: editor
          text: ""
          size_hint_y: None
          height: max(self.minimum_height, self.parent.height)
          background_color: 0.1, 0.1, 0.1, 1
          foreground_color: 1.0, 1.0, 1.0, 1
          on_text: root._on_editor_text()

      ScrollView:
        id: backup_scroll
        do_scroll_x: False
        bar_width: '4dp'
        scroll_distance: '10dp'
        scroll_timeout: 150
        size_hint_x: 0
        opacity: 0

        CustomTextInput:
          id: backup_editor
          text: ""
          size_hint_y: None
          height: max(self.minimum_height, self.parent.height)
          background_color: 0.1, 0.1, 0.1, 1
          foreground_color: 1.0, 1.0, 1.0, 1
          on_text: root._on_backup_editor_text()

    CustomLabel:
      id: status_label
      text: "Not loaded"
      font_size: '15sp'
      color: 0.6, 0.6, 0.6, 1
      size_hint_y: None
      height: '28dp'
      halign: "left"
      valign: "middle"
