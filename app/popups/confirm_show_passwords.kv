#:kivy 2.3

<ConfirmShowPasswordsPopup>:
  title: ""
  title_size: 0
  separator_height: 0
  size_hint: 0.75, 0.4
  auto_dismiss: False
  password_input: password_input
  error_label: error_label

  BoxLayout:
    orientation: "vertical"
    padding: '16dp'
    spacing: '12dp'

    canvas.before:
      Color:
        rgba: root._bg_color
      Rectangle:
        pos: self.pos
        size: self.size

    CustomLabel:
      text: "Master Password"
      halign: "left"
      size_hint_y: None
      height: '24dp'

    CustomTextInput:
      id: password_input
      password: True
      multiline: False
      size_hint_y: None
      height: '48dp'
      on_text_validate: root.confirm()

    CustomLabel:
      id: error_label
      text: ""
      color: 1.0, 0.3, 0.3, 1
      opacity: 0
      halign: "center"
      size_hint_y: None
      height: '24dp'

    BoxLayout:
      size_hint_y: None
      height: '48dp'
      spacing: '12dp'

      CustomButton:
        text: "Confirm"
        on_release: root.confirm()

      CustomButton:
        text: "Cancel"
        background_color: 0.4, 0.4, 0.4, 1
        on_release: root.cancel()
